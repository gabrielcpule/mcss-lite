{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "MCSS-Lite semantic color tokens, dark mode. Use these (or component tokens) in UI code.",
  "color": {
    "text": {
      "default": {
        "$value": "{color.gray.50}",
        "$description": "Default body and heading text.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "muted": {
        "$value": "{color.gray.200}",
        "$description": "Secondary text: labels, supporting copy.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "subtle": {
        "$value": "{color.gray.400}",
        "$description": "Tertiary text: help text, placeholders, icons.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "inverse": {
        "$value": "{color.gray.900}",
        "$description": "Text on an inverted (dark in light mode) background.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "on-action": {
        "$value": "{color.gray.900}",
        "$description": "Text on --color-action-primary.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "link": {
        "$value": "{color.blue.300}",
        "$description": "Link text.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "link-hover": {
        "$value": "{color.blue.200}",
        "$description": "Link text on hover.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "disabled": {
        "$value": "{color.gray.600}",
        "$description": "Text in disabled controls.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "success": {
        "$value": "{color.green.300}",
        "$description": "Text on --color-background-success.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "warning": {
        "$value": "{color.yellow.300}",
        "$description": "Text on --color-background-warning.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "error": {
        "$value": "{color.red.300}",
        "$description": "Text on --color-background-error.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "info": {
        "$value": "{color.cyan.300}",
        "$description": "Text on --color-background-info.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      }
    },
    "background": {
      "default": {
        "$value": "{color.gray.900}",
        "$description": "Page background.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "subtle": {
        "$value": "{color.gray.800}",
        "$description": "Subtle section or hover background.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "muted": {
        "$value": "{color.gray.700}",
        "$description": "Muted fill for neutral badges and chips.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "raised": {
        "$value": "{color.gray.800}",
        "$description": "Cards, modals and other raised surfaces.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "interactive": {
        "$value": "{color.gray.800}",
        "$description": "Resting background of controls (buttons, inputs).",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "interactive-hover": {
        "$value": "{color.gray.850}",
        "$description": "Hover background of controls.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "disabled": {
        "$value": "{color.gray.850}",
        "$description": "Background of disabled controls.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "overlay": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.7,
          "hex": "#000000"
        },
        "$description": "Modal backdrop.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "success": {
        "$value": "{color.green.950}",
        "$description": "Background for success messages and badges.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "warning": {
        "$value": "{color.yellow.950}",
        "$description": "Background for warning messages and badges.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "error": {
        "$value": "{color.red.950}",
        "$description": "Background for error messages and badges.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      },
      "info": {
        "$value": "{color.cyan.950}",
        "$description": "Background for info messages and badges.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.700}",
        "$description": "Dividers and card borders.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      },
      "strong": {
        "$value": "{color.gray.600}",
        "$description": "Emphasized borders.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      },
      "interactive": {
        "$value": "{color.gray.450}",
        "$description": "Borders of controls (inputs, default buttons). Meets 3:1 non-text contrast.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      },
      "focus": {
        "$value": "{color.blue.300}",
        "$description": "Focus outline color.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      },
      "success": {
        "$value": "{color.green.800}",
        "$description": "Border for success states.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      },
      "warning": {
        "$value": "{color.yellow.800}",
        "$description": "Border for warning states.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      },
      "error": {
        "$value": "{color.red.800}",
        "$description": "Border for error states.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      },
      "info": {
        "$value": "{color.cyan.800}",
        "$description": "Border for info states.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      }
    },
    "action": {
      "primary": {
        "$root": {
          "$value": "{color.blue.300}",
          "$description": "Primary action background (primary buttons, selection).",
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL",
              "STROKE_COLOR"
            ]
          }
        },
        "hover": {
          "$value": "{color.blue.200}",
          "$description": "Primary action on hover.",
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL",
              "STROKE_COLOR"
            ]
          }
        },
        "active": {
          "$value": "{color.blue.100}",
          "$description": "Primary action while pressed.",
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL",
              "STROKE_COLOR"
            ]
          }
        }
      },
      "neutral-hover": {
        "$value": "{color.gray.700}",
        "$description": "Hover background for ghost and icon buttons.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ]
        }
      }
    },
    "focus-ring": {
      "$root": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.4235,
            0.7059,
            0.9333
          ],
          "alpha": 0.35,
          "hex": "#6cb4ee"
        },
        "$description": "Soft focus halo around focused inputs.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      },
      "error": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9569,
            0.6627,
            0.6902
          ],
          "alpha": 0.3,
          "hex": "#f4a9b0"
        },
        "$description": "Focus halo for inputs in the error state.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      }
    }
  }
}
