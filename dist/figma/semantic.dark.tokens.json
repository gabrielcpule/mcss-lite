{
  "space": {
    "component-padding": {
      "$type": "dimension",
      "$value": "{space.4}",
      "$description": "Default inner padding for components.",
      "$extensions": {
        "com.figma.scopes": [
          "GAP",
          "WIDTH_HEIGHT"
        ]
      }
    },
    "element-gap": {
      "$type": "dimension",
      "$value": "{space.3}",
      "$description": "Gap between sibling elements inside a component.",
      "$extensions": {
        "com.figma.scopes": [
          "GAP",
          "WIDTH_HEIGHT"
        ]
      }
    },
    "section-gap": {
      "$type": "dimension",
      "$value": "{space.8}",
      "$description": "Gap between page sections.",
      "$extensions": {
        "com.figma.scopes": [
          "GAP",
          "WIDTH_HEIGHT"
        ]
      }
    }
  },
