{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabrielcpule/mcss-lite/schemas/content.schema.json",
  "title": "MCSS-Lite content guidelines",
  "type": "object",
  "required": ["title", "intro", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "intro": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "text", "do", "dont"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z-]+$" },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "do": { "type": "string" },
          "dont": { "type": "string" },
          "enforcedBy": { "type": "string", "description": "Validator rule id that checks this rule." }
        }
      }
    }
  }
}
