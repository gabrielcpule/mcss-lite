{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabrielcpule/mcss-lite/schemas/component.schema.json",
  "title": "MCSS-Lite contract",
  "description": "Machine-readable contract for one MCSS-Lite block (component, layout primitive) or the utility set.",
  "type": "object",
  "required": ["name", "block", "layer", "status", "description"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "description": "Human name, e.g. \"Button\"." },
    "block": { "type": "string", "pattern": "^[clu]-[a-z0-9-]+$|^u-\\*$", "description": "Root class, e.g. c-button. Utilities use u-*." },
    "layer": { "type": "string", "enum": ["layout", "component", "utility"] },
    "status": {
      "type": "string",
      "enum": ["beta", "stable", "deprecated"],
      "description": "beta: shipped and validated, but the API may change in a minor version. stable: changes only in a major version. deprecated: use the replacement."
    },
    "replacement": { "type": "string", "description": "Class to use instead, when status is deprecated." },
    "since": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Package version that introduced the block." },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "HTML elements the block may be applied to." },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group", "exclusive", "values"],
        "additionalProperties": false,
        "properties": {
          "group": { "type": "string" },
          "exclusive": { "type": "boolean", "description": "When true, at most one value of this group may be applied at once." },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "description"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "required": { "type": "boolean" }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z-]+$" },
          "description": { "type": "string" },
          "pair": { "type": "string", "description": "Native attribute or ARIA that must accompany data-state." },
          "native": {
            "type": "boolean",
            "description": "The state is a native attribute or ARIA (checked, disabled, aria-invalid), not data-state. Its selector must appear in the CSS, and data-state with this name is invalid."
          },
          "selector": {
            "type": "string",
            "description": "CSS selector suffix that styles a native state, e.g. :checked or [aria-invalid=\"true\"]."
          }
        },
        "if": { "type": "object", "properties": { "native": { "const": true } }, "required": ["native"] },
        "then": { "type": "object", "required": ["selector"] }
      }
    },
    "classes": {
      "type": "array",
      "description": "Utility layer only: the individual utility classes.",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^u-[a-z0-9-]+$" },
          "description": { "type": "string" }
        }
      }
    },
    "customProperties": {
      "type": "array",
      "description": "Local custom properties the block reads, which callers may set inline.",
      "items": {
        "type": "object",
        "required": ["name", "default", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^--[a-z0-9-]+$" },
          "default": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "children": { "type": "array", "items": { "type": "string" }, "description": "Structural rules for children." },
    "tokens": { "type": "array", "items": { "type": "string", "pattern": "^--[a-z0-9-]+$" }, "description": "Tokens that theme this block." },
    "guidelines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whenToUse": { "type": "array", "items": { "type": "string" }, "description": "Situations this part is the right choice for." },
        "whenNotToUse": { "type": "array", "items": { "type": "string" }, "description": "Situations to pick another part. Name it in backticks, e.g. `c-badge`, and the part sheet links it." },
        "use": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "doDont": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["do", "dont"],
            "additionalProperties": false,
            "properties": {
              "do": {
                "type": "object",
                "required": ["text"],
                "additionalProperties": false,
                "properties": {
                  "text": { "type": "string" },
                  "html": { "type": "string", "description": "Markup shown on the part sheet. Must validate with 0 issues." }
                }
              },
              "dont": {
                "type": "object",
                "required": ["text"],
                "additionalProperties": false,
                "properties": {
                  "text": { "type": "string" },
                  "html": { "type": "string", "description": "Markup shown on the part sheet with the validator's real output." },
                  "rule": { "type": "string", "description": "Validator rule id this markup must trigger. Without it, the sheet labels the don't as guidance only." }
                }
              }
            }
          }
        },
        "content": { "type": "array", "items": { "type": "string" }, "description": "Writing rules for labels and text inside this part." }
      }
    },
    "a11y": { "type": "array", "items": { "type": "string" } },
    "keyboard": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "action"],
        "additionalProperties": false,
        "properties": { "key": { "type": "string" }, "action": { "type": "string" } }
      }
    },
    "sources": {
      "type": "array",
      "description": "Research the guidance is grounded in.",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" } }
      }
    },
    "related": { "type": "array", "items": { "type": "string" } },
    "examples": { "type": "array", "items": { "type": "string", "pattern": "\\.html$" } }
  }
}
